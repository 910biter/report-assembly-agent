# Local path or Hugging Face model id. A local path is recommended for offline comparison.
MODEL_PATH_OR_ID=
SERVED_MODEL_NAME=qwen3.6-27b

# vLLM physical serving envelope. Keep these identical across comparison runs.
VLLM_HOST=127.0.0.1
VLLM_PORT=8100
MAX_MODEL_LEN=24576
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.98

# Reuse an existing installation with VLLM_BIN. Otherwise VLLM_INSTALL_SPEC is
# installed into the package-private virtual environment.
VLLM_BIN=
VLLM_INSTALL_SPEC=vllm
KV_CACHE_DTYPE=
CALCULATE_KV_SCALES=0
CPU_OFFLOAD_GB=
STARTUP_TIMEOUT_SECONDS=1800

# Runner load. These values affect performance comparability.
RUNNER_CONCURRENCY=1
RUNNER_REPEAT=3
RUNNER_WARMUP=1
RUNNER_TIMEOUT_SECONDS=900
SAMPLE_INTERVAL_SECONDS=0.5
RESULT_FILE=result.json
