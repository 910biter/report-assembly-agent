# Keep this file outside source control after assigning a real password.
NEO4J_PASSWORD=change-me-before-starting
IRA_NEO4J_URI=bolt://127.0.0.1:7687
IRA_NEO4J_USER=neo4j
IRA_NEO4J_PASSWORD=change-me-before-starting
IRA_NEO4J_DATABASE=neo4j
# shadow records and projects graph data but leaves Analysis unchanged.
# active adds validated Graph RAG paths to Analysis with a safe fallback.
IRA_GRAPH_MODE=shadow
