# Stable production baseline. Change these values only during a maintenance window;
# restarting vLLM reloads the model weights from NAS.
IRA_VLLM_HOST=127.0.0.1
IRA_VLLM_PORT=8100
IRA_VLLM_MAX_MODEL_LEN=24576
IRA_VLLM_MAX_NUM_SEQS=2
IRA_VLLM_MAX_BATCHED_TOKENS=8192
IRA_VLLM_GPU_MEMORY_UTILIZATION=0.98

# Experimental long-context options. Leave unset for full-precision KV cache.
# IRA_VLLM_KV_CACHE_DTYPE=fp8
# IRA_VLLM_CALCULATE_KV_SCALES=1
# IRA_VLLM_CPU_OFFLOAD_GB=0
