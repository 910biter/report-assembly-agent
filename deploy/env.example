# 生产环境配置模板(复制为 .env 后按需修改)
# 数据库:PostgreSQL(唯一实现,SQLAlchemy ORM);默认连本地 PG(ira/ira@127.0.0.1:5432/ira),
# 远程/生产设 IRA_DB_URL=postgresql+psycopg://user:pass@host:5432/db

# 服务监听
IRA_HOST=0.0.0.0
IRA_PORT=8000

# OpenAI-compatible generation service + local CPU embedding
IRA_GENERATION_URL=http://127.0.0.1:8100/v1
IRA_GENERATION_MODEL=qwen3.6-27b
IRA_GENERATION_TOKENIZER_PATH=/home/nas511/zhangruqi/models/Qwen3.6-27B-GPTQ-Int4
IRA_GENERATION_API_KEY=
IRA_EMBEDDING_BACKEND=transformers-cpu
IRA_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
IRA_EMBEDDING_MODEL_PATH=/home/nas511/zhangruqi/models/Qwen3-Embedding-0.6B
IRA_LLM_CONCURRENCY=2
IRA_MODEL_CONTEXT_WINDOW_TOKENS=24576
IRA_INTERACTIVE_CONCURRENCY=1
IRA_INTERACTIVE_INPUT_TOKENS=6144
IRA_INTERACTIVE_HISTORY_TOKENS=1536
IRA_INTERACTIVE_OUTPUT_TOKENS=1024

# 向量检索(Qdrant)
IRA_QDRANT_URL=http://127.0.0.1:6333
IRA_VECTOR_BACKEND=qdrant

# 离线模型(HF 缓存必须已拷贝,见 DEPLOY.md 五)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# CPU parsing and resident vLLM are independent
IRA_TORCH_COMPILE=true

# 可选:PostgreSQL
# IRA_DB_URL=postgresql://user:pass@127.0.0.1:5432/ira
