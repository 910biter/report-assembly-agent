# 远端模型网关(本地资源不够,推理全走远端)
IRA_OLLAMA_URL=http://100.120.119.108:11434
IRA_GENERATION_MODEL=qwen-agent:latest
IRA_EMBEDDING_MODEL=qwen-embed:latest

# 本地数据目录
IRA_RUNTIME_ROOT=/home/biter/agent/report-assembly-agent/runtime

# 向量检索:Qdrant(本地容器,集合首次写入时自动创建)
IRA_VECTOR_BACKEND=qdrant
