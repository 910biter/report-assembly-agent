# Local credentials and deployment overrides must never enter source archives.
.env
.env.*
!.env.example
__pycache__/
*.pyc
*.db
runtime/
deploy/offline/
*.log
.DS_Store
node_modules/
*.tsbuildinfo
*.zip
*.map
frontend/src/**/*.js
frontend/vite.config.js
frontend/vite.config.d.ts
docs/superpowers/
# Issuer secrets and generated customer licenses never belong in source archives.
*.private.pem
*.license
issuance.jsonl
license-secrets/
license-requests/
key-password
issuer-password*
.native-build/
app/licensing/*.so
app/licensing/*.pyd
